      <column caption='Sales – High Performers' datatype='real' name='[Calculation_1548956831622639616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Cluster Label] = &quot;High Performing&quot; THEN [Sales (data_products.csv)] END)' />
      </column>
      <column caption='AVG Profit Per Product' datatype='real' name='[Calculation_1548956831624601601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit (data_products.csv)])/ COUNTD([Product Name (data_products.csv)])' />
      </column>
      <column caption='Discount – Clearance' datatype='real' name='[Calculation_1548956831625383938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG( IF[Cluster Label] = &quot;Clearance&quot; THEN [Discount (data_products.csv)]END)' />
      </column>
      <column caption='% of High-performers ' datatype='real' name='[Calculation_1548956831629119491]' role='measure' type='quantitative'>
