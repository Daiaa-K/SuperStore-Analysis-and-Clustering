      <column caption='% of Clearance' datatype='real' name='[Calculation_1548956831643279364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Cluster Label]=&quot;Clearance&quot; THEN [Product Name (data_products.csv)] END)/COUNT([Product Name (data_products.csv)])' />
